{
  "name": "@aspec/testing",
  "version": "1.0.0",
  "description": "Testing utilities: scaffolding, API test clients, database fixtures, factories, auth and authorisation helpers, HTTP mocking, environment isolation and coverage presets.",
  "type": "module",
  "license": "MIT",
  "author": "ASPEC TECH",
  "homepage": "https://aspec.tech/modules/aspec/testing",
  "repository": {
    "type": "git",
    "url": "https://github.com/ASPEC-RACING-PTY-LTD/aspecdev",
    "directory": "modules/testing"
  },
  "keywords": [
    "aspec",
    "testing",
    "vitest",
    "fixtures",
    "factories",
    "mock-fetch",
    "test-client"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "bin": {
    "aspec-testing": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "default": "./dist/sql.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "default": "./dist/coverage.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "default": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "templates",
    "aspec.module.json",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0",
    "pg": "^8.0.0",
    "vitest": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "fastify": "^5.12.5",
    "hono": "^4.13.10",
    "pg": "^8.23.0"
  }
}

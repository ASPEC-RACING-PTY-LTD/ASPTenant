{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASPEC orgs module configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode"],
  "properties": {
    "mode": {
      "enum": ["single", "multi"],
      "description": "single: implicit default organisation. multi: create and resolve tenants."
    },
    "storage": {
      "enum": ["memory", "postgres", "sqlite"],
      "default": "memory"
    },
    "tablePrefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_$",
      "default": "orgs_"
    },
    "tenantStrategy": {
      "enum": ["shared", "schema", "database"],
      "default": "shared"
    },
    "tenantResolution": {
      "enum": ["header", "subdomain", "path", "custom"],
      "default": "header"
    },
    "invitationTtlMs": {
      "type": "integer",
      "minimum": 1000,
      "default": 604800000
    },
    "acceptUrl": { "type": "string" },
    "appName": { "type": "string", "default": "our application" }
  }
}

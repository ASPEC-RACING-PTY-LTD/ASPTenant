{
  "name": "@aspec/observability",
  "version": "1.0.0",
  "description": "Structured logging, correlation IDs, metrics, health, readiness and liveness checks, error and performance instrumentation and OpenTelemetry tracing integration.",
  "type": "module",
  "license": "MIT",
  "author": "ASPEC TECH",
  "homepage": "https://aspec.tech/modules/aspec/observability",
  "repository": {
    "type": "git",
    "url": "https://github.com/ASPEC-RACING-PTY-LTD/aspecdev",
    "directory": "modules/observability"
  },
  "keywords": [
    "aspec",
    "observability",
    "logging",
    "metrics",
    "tracing",
    "opentelemetry",
    "prometheus",
    "health"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "default": "./dist/adapters/fastify.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "default": "./dist/adapters/hono.js"
    },
    "./fetch": {
      "types": "./dist/adapters/fetch.d.ts",
      "default": "./dist/adapters/fetch.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "default": "./dist/otel.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "templates",
    "aspec.module.json",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.0",
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "fastify": "^5.12.5",
    "hono": "^4.13.10"
  }
}

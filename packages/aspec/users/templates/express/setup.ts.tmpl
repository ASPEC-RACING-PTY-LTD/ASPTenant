import { createUsers } from '{{ imports.root }}';
import { createUsersAdminRouter, createUsersSelfServiceRouter } from '{{ imports.express }}';
import { createMemoryUsersStore } from '{{ imports.memory }}';

export const users = createUsers({
  store: createMemoryUsersStore(),
  // Admin routes deny every request until this delegates to your authorisation layer.
  permissions: { can: async () => false },
  invitations: {
    acceptUrl: process.env.USERS_ACCEPT_URL,
    appName: process.env.USERS_APP_NAME ?? 'our application',
  },
});

export const adminRouter = createUsersAdminRouter(users, {
  async resolveActor(req) {
    // Return the signed-in subject from your authentication layer.
    void req;
    return null;
  },
});

export const selfServiceRouter = createUsersSelfServiceRouter(users, {
  async resolveActor(req) {
    void req;
    return null;
  },
});

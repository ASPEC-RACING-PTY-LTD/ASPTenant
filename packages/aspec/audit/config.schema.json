{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aspec.tech/schemas/modules/audit/config.json",
  "title": "ASPEC Audit configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tablePrefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,30}$",
      "default": "audit_",
      "description": "SQL table name prefix."
    },
    "defaultCategory": {
      "type": "string",
      "enum": ["security", "data", "admin", "system"],
      "default": "system"
    },
    "maxEventBytes": {
      "type": "integer",
      "minimum": 1024,
      "default": 65536
    },
    "maxDiffEntries": {
      "type": "integer",
      "minimum": 0,
      "default": 200
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultDays": { "type": "number", "exclusiveMinimum": 0, "default": 90 },
        "categories": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 },
          "properties": {
            "security": { "type": "number", "exclusiveMinimum": 0 },
            "data": { "type": "number", "exclusiveMinimum": 0 },
            "admin": { "type": "number", "exclusiveMinimum": 0 },
            "system": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hmacKeyEnv": {
          "type": "string",
          "description": "Environment variable holding the HMAC key (at least 32 bytes)."
        },
        "hmacKeyId": { "type": "string", "default": "k1" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxEvents": { "type": "integer", "minimum": 1, "default": 10000 }
      }
    },
    "jsonl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "maxBytes": { "type": "integer", "minimum": 1024 },
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 5 },
        "fsync": { "type": "boolean", "default": false }
      }
    }
  }
}

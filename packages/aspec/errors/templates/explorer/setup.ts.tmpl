{{#if framework == "express"}}
import { createExpressErrorHandling } from '{{ imports.express }}';
export const errors = createExpressErrorHandling({
  format: '{{ format }}',
  debug: {{ debug }},
  typeBaseUri: process.env.ERRORS_TYPE_BASE_URI ?? 'about:blank',
});
{{else}}
{{#if framework == "fastify"}}
import { registerErrorHandling } from '{{ imports.fastify }}';
export async function setupErrors(app: Parameters<typeof registerErrorHandling>[0]) {
  await registerErrorHandling(app, { format: '{{ format }}', debug: {{ debug }} });
}
{{else}}
{{#if framework == "hono"}}
import { createHonoErrorHandling } from '{{ imports.hono }}';
export const errors = createHonoErrorHandling({ format: '{{ format }}', debug: {{ debug }} });
{{else}}
{{#if framework == "fetch"}}
import { withErrorHandling } from '{{ imports.fetch }}';
export const wrap = (h: Parameters<typeof withErrorHandling>[0]) => withErrorHandling(h, { format: '{{ format }}', debug: {{ debug }} });
{{else}}
import { createErrorHandler } from '{{ imports.root }}';
export const errors = createErrorHandler({ format: '{{ format }}', debug: {{ debug }} });
{{/if}}
{{/if}}
{{/if}}
{{/if}}

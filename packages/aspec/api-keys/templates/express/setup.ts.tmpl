import { createApiKeys } from '{{ imports.root }}';
import { createMemoryStore } from '{{ imports.memory }}';
import { createApiKeyMiddleware, createApiKeysAdminRouter } from '{{ imports.express }}';

const pepper = process.env.API_KEYS_PEPPER;
if (!pepper || Buffer.byteLength(pepper, 'utf8') < 32) {
  throw new Error('API_KEYS_PEPPER must be set to at least 32 bytes');
}

export const apiKeys = createApiKeys({
  store: createMemoryStore(),
  pepper,
  prefix: process.env.API_KEYS_PREFIX ?? 'ak_live_',
});

/** Mount on protected routes: `app.use('/v1', apiKeyMiddleware)`. */
export const apiKeyMiddleware = createApiKeyMiddleware(apiKeys);

/**
 * Mount with `app.use('/admin/api-keys', createAdminRouter({ resolveActor, authorize }))`,
 * where resolveActor maps a request to the authenticated subject.
 */
export function createAdminRouter(options: Parameters<typeof createApiKeysAdminRouter>[1]) {
  return createApiKeysAdminRouter(apiKeys, options);
}

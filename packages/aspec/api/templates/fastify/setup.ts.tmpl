import { createApi, defineRoute, ok } from '{{ imports.root }}';
import { fastifyApi } from '{{ imports.fastify }}';

export const api = createApi({
  info: {
    title: process.env.API_TITLE ?? 'API',
    version: process.env.API_VERSION ?? '1.0.0',
  },
  routes: [defineRoute({ method: 'get', path: '/health', handler: async () => ok({ ok: true }) })],
});

export const apiPlugin = fastifyApi;
export const apiPluginOpts = { api };
